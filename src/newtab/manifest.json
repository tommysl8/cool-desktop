{
  "manifest_version": 3,
  "name": "PixelClock Desktop",
  "version": "1.0.0",
  "description": "Your PixelClock's pixel-art scene as the new tab: seasons, holidays and the time of day, with your links and a small terminal.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "search"
  ],
  "optional_permissions": [
    "topSites"
  ],
  "host_permissions": [
    "http://pixelclock.local/*"
  ],
  "key": ""
}
